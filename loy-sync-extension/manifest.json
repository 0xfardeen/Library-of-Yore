{
  "manifest_version": 3,
  "name": "Library of Yore Sync",
  "version": "1.0.0",
  "description": "Automatically tracks the chapter you're reading and syncs progress to Library of Yore.",

  "permissions": [
    "storage",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:7185/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.novelfire.net/*",
        "*://*.novelfire.com/*",
        "*://*.freewebnovel.com/*",
        "*://*.wuxiaworld.com/*",
        "*://*.webnovel.com/*",
        "*://*.royalroad.com/*",
        "*://*.scribblehub.com/*",
        "*://*.lightnovelworld.com/*",
        "*://*.lightnovelpub.com/*",
        "*://*.novelpub.com/*",
        "*://*.novelupdates.com/*",
        "*://*.readlightnovel.me/*",
        "*://*.mtlnovel.com/*",
        "*://*.translateindo.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon16.png",
      "48":  "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Library of Yore Sync"
  },

  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
